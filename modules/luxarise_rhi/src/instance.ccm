module;
#include <memory>
#include <string>
#include <tuple>
#include <cstdint>
#include <vulkan/vulkan.hpp>
#include <print>
#include <iostream>
export module luxarise.rhi:Instance;

namespace luxarise::rhi{
    export struct InstanceCreateInfo{
        std::string applicationName{"Luxarise Application"};
        std::tuple<std::uint32_t, std::uint32_t, std::uint32_t> applicationVersion{0, 1, 0};
        std::uint32_t apiVersion{VK_API_VERSION_1_3};
    };
    class Instance_S{
        public:
        Instance_S(const InstanceCreateInfo& createInfo){
            vk::ApplicationInfo appInfo{};
            appInfo.setPApplicationName(createInfo.applicationName.c_str())
            .setApplicationVersion(VK_MAKE_VERSION(std::get<0>(createInfo.applicationVersion), std::get<1>(createInfo.applicationVersion), std::get<2>(createInfo.applicationVersion)))
            .setApiVersion(createInfo.apiVersion);

            vk::InstanceCreateInfo instanceCreateInfo{};
            instanceCreateInfo.setPApplicationInfo(&appInfo);

            try {
                this->instance = vk::createInstance(instanceCreateInfo, nullptr);
            } catch (const std::exception& e) {
                std::println(std::cerr, "Error creating Vulkan instance: {}", e.what());
            }
                

        }
        ~Instance_S(){
            this->instance.destroy();
        }

        private:

        vk::Instance instance;

    };

    export using Instance = std::unique_ptr<Instance_S>;

    export Instance createInstance(const InstanceCreateInfo& createInfo){
        return std::make_unique<Instance_S>(createInfo);
    }
}